{
  "title": "PostgreSQL Overview",
  "uid": "postgres-overview",
  "tags": ["postgres", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "DB size",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "pg_database_size_bytes{datname=\"app\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "Active connections",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(pg_stat_activity_count)", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "Transactions/sec",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum(rate(pg_stat_database_xact_commit{datname=\"app\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "Deadlocks (15m)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "increase(pg_stat_database_deadlocks{datname=\"app\"}[15m])", "refId": "A"}],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "Connections by state",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{
        "expr": "sum by(state) (pg_stat_activity_count)",
        "legendFormat": "{{state}}", "refId": "A"
      }],
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "Transactions/sec",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_xact_commit{datname=\"app\"}[5m]))", "legendFormat": "commit", "refId": "A"},
        {"expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"app\"}[5m]))", "legendFormat": "rollback", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "Rows read/written",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {"expr": "sum(rate(pg_stat_database_tup_returned{datname=\"app\"}[5m]))", "legendFormat": "returned", "refId": "A"},
        {"expr": "sum(rate(pg_stat_database_tup_fetched{datname=\"app\"}[5m]))", "legendFormat": "fetched", "refId": "B"},
        {"expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"app\"}[5m]))", "legendFormat": "inserted", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "DB size growth",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "pg_database_size_bytes{datname=\"app\"}", "legendFormat": "app", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    }
  ]
}
